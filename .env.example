COMPOSE_PROFILES=

APP_PORT=8080
LOG_LEVEL=info
MIGRATE_ON_START=true

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576
TRUST_PROXY_HEADERS=false
SHUTDOWN_TIMEOUT=15s

STARTUP_RETRY_ATTEMPTS=30
STARTUP_RETRY_INTERVAL=2s

MYSQL_HOST_PORT=3306
MYSQL_DATABASE=tasks
MYSQL_USER=tasks
MYSQL_PASSWORD=change-me-tasks
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=25
MYSQL_CONN_MAX_LIFETIME=5m

JWT_SECRET=change-me-to-a-long-random-string-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

CACHE_TASKS_TTL=5m
CACHE_INVALIDATE_TIMEOUT=2s
CACHE_INVALIDATE_RETRY_INTERVAL=1s
CACHE_BREAKER_FAILURES=5
CACHE_BREAKER_OPEN_TIMEOUT=10s
CACHE_BREAKER_HALF_OPEN_REQUESTS=1

RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
RATE_LIMIT_CLIENT_TTL=3m
RATE_LIMIT_CLEANUP_INTERVAL=1m

CLOUDBEAVER_PORT=8978
CLOUDBEAVER_ADMIN=cbadmin
CLOUDBEAVER_ADMIN_PASSWORD=ChangeMe123
